<%# Links to the issues the import has just created or updated.
    title  - the heading of the section
    issues - an array of [id, subject] pairs %>
<% if issues.present? %>
  <% shown = issues.first(ImporterController::RESULT_ISSUES_LIMIT) %>
  <h3><%= title %></h3>

  <table class="list importer-issue-list">
    <thead>
      <tr>
        <th>#</th>
        <th><%= l(:field_subject) %></th>
      </tr>
    </thead>
    <tbody>
      <% shown.each_with_index do |(id, subject), index| %>
        <tr class="<%= index.even? ? 'odd' : 'even' %>">
          <td><%= link_to "##{id}", issue_path(id) %></td>
          <td><%= link_to (subject.presence || "##{id}"), issue_path(id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="importer-issue-list-footer">
    <% if issues.size > shown.size %>
      <%= l(:label_result_issues_more, :count => issues.size - shown.size) %>
    <% end %>
    <% if issues.size <= ImporterController::RESULT_ISSUE_LIST_LINK_LIMIT %>
      <%= link_to l(:label_result_open_in_issue_list),
                  issues_path(:set_filter => 1,
                              :issue_id => issues.map(&:first).join(',')) %>
    <% end %>
  </p>
<% end %>
