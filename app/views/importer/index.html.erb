<h2><%=l(:label_issue_importer)%></h2>

<%= form_tag({:action => 'match'}, {:multipart => true, :id => 'csv-upload-form'}) do %>
  <%= hidden_field_tag 'project_id', @project.id %>

  <p><label><%=l(:label_upload_notice)%></label><br/>
    <%= file_field_tag 'file', :size => 60, :accept => '.csv,.txt,.xlsx'%></p>

  <fieldset class="box" id="xlsx-options">
    <legend>Excel (.xlsx)</legend>
    <p><%= label_tag 'xlsx_sheet', l(:label_xlsx_sheet) %>
      <%= text_field_tag 'xlsx_sheet', nil, :size => 30 %><br/>
      <em><%= l(:text_xlsx_sheet) %></em></p>
  </fieldset>

  <fieldset class="box" id="csv-options"><legend><%= l(:label_upload_format) %> (CSV / TXT)</legend>
    <p><label><%=l(:label_upload_encoding)%></label>
      <%= select_tag "encoding",
          "<option value=\"W\">Windows-1251 (CP1251)</option>" \
          "<option value=\"U\">UTF8</option>" \
          "<option value=\"EUC\">EUC</option>" \
          "<option value=\"S\">SJIS</option>" \
          "<option value=\"N\">None</option>".html_safe %></p>

    <p><label><%=l(:label_upload_splitter)%></label>
      <%= text_field_tag "splitter", ';', {:size => 3, :maxlength => 1}%></p>

    <p><label><%=l(:label_upload_wrapper)%></label>
      <%= text_field_tag "wrapper", '"', {:size => 3, :maxlength => 1}%></p>
  </fieldset>

  <%= submit_tag l(:button_upload), :id => 'upload-button' %>
<% end %>

<script type="text/javascript">
  $(document).ready(function() {
    function updateFileOptions() {
      var isXlsx = /\.xlsx$/i.test($('#file').val());
      $('#xlsx-options').toggle(isXlsx).find(':input').prop('disabled', !isXlsx);
      $('#csv-options').toggle(!isXlsx).find(':input').prop('disabled', isXlsx);
    }
    $('#file').on('change', updateFileOptions);
    updateFileOptions();
    $('#csv-upload-form').on('submit', function() {
      $('#upload-button').prop('disabled', true).css({opacity: '0.65', cursor: 'not-allowed'});
    });
  });
</script>
