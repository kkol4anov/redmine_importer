<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'importer', :plugin => 'redmine_importer' %>
<% end %>

<h2><%= l(:label_match_columns) %></h2>

<%# The import runs inside the request started by the form below, which stays
    open until the whole file has been processed. The panel takes the place of
    the form while that request is in flight and shows how far the import has
    got, by polling the state the server writes into its row along the way. %>
<div id="import-progress-panel" style="display: none;"
     data-progress-url="<%= url_for(:controller => 'importer', :action => 'progress',
                                    :project_id => @project.id,
                                    :import_timestamp => @import_timestamp) %>"
     data-stage-labels="<%= { 'preparing'  => l(:label_import_stage_preparing),
                              'importing'  => l(:label_import_stage_importing),
                              'deleting'   => l(:label_import_stage_deleting),
                              'finalizing' => l(:label_import_stage_finalizing),
                              'finished'   => l(:label_import_stage_finished),
                              'failed'     => l(:label_import_stage_failed) }.to_json %>">
  <h3 id="import-progress-stage"><%= l(:label_import_stage_preparing) %></h3>

  <%# Same markup as the progress of the import built into Redmine, so that it
      is the same widget with the same look. %>
  <div id="import-details">
    <div id="import-progress"><div id="progress-label">0 / 0</div></div>
  </div>

  <p class="importer-progress-counters">
    <span class="importer-progress-write"><%= l(:label_import_progress_created) %> <span id="import-progress-created">0</span></span>
    <span class="importer-progress-write"><%= l(:label_import_progress_updated) %> <span id="import-progress-updated">0</span></span>
    <span class="importer-progress-write"><%= l(:label_import_progress_unchanged) %> <span id="import-progress-unchanged">0</span></span>
    <span class="importer-progress-delete" style="display: none;"><%= l(:label_import_progress_deleted) %> <span id="import-progress-deleted">0</span></span>
    <span><%= l(:label_import_progress_skipped) %> <span id="import-progress-skipped">0</span></span>
    <span><%= l(:label_import_progress_failed) %> <span id="import-progress-failed">0</span></span>
  </p>

  <p class="importer-progress-note"><%= l(:text_import_progress_note) %></p>
  <p class="importer-progress-note importer-progress-stalled"
     id="import-progress-stalled" style="display: none;"><%= l(:text_import_progress_unavailable) %></p>
</div>

<%= form_tag({:action => 'result'}, {:multipart => true, :id => 'map_form'}) do %>
  <%= hidden_field_tag 'project_id', @project.id %>
  <%= hidden_field_tag 'import_timestamp', @import_timestamp %>

  <fieldset class="box">
    <legend><%= l(:label_match_select) %></legend>
    <% @headers.each do |column| %>
      <% col = force_utf8(column) %>
      <label class="tabular">
        <%= col %>:
        <%= select_tag "fields_map[#{col}]",
          raw("<option value=\"\">#{l(:option_ignore)}</option>") +
            options_for_select( @attrs, matched_attrs(column) ) %>
      </label>
    <% end %>
  </fieldset>

  <fieldset class="box">
    <legend><%= l(:label_import_rule) %></legend>

    <%# A mode of its own: the rows name the issues to destroy and nothing is
        written to them, so every option that only applies to writing is
        switched off below while it is on. %>
    <div id="delete_issues_wrapper">
      <label>
        <%= check_box_tag "delete_issues", true, false %>
        <%= l(:label_delete_issues) %>
      </label>
      <%= importer_hint(l(:label_delete_issues_info)) %>
      <span id="delete_issues_warning" class="importer-warning" style="display: none;">
        <%= l(:warning_delete_without_unique_field) %>
      </span>
    </div>

    <label>
      <%= check_box_tag "use_issue_id", true, false %>
      <%= l(:label_importer_use_issue_id) %>
    </label>
    <%= importer_hint(l(:label_importer_use_issue_id_info)) %>
    <span id="use_issue_id_warning" class="importer-warning" style="display: none;">
      <%= l(:warning_id_column_not_mapped) %>
    </span>
    <br/>

    <div class="rule-row">
      <label class="rule-label" for="default_tracker"><%= l(:label_default_tracker) %></label>
      <%= select_tag "default_tracker",
        options_from_collection_for_select(@project.trackers, 'id', 'name') %>
    </div>

    <div id="unique_field_wrapper" class="rule-row">
      <label class="rule-label" for="unique_field"><%= l(:label_unique_field) %></label>
      <%= select_tag "unique_field",
        raw("<option value=\"\">#{l(:option_ignore)}</option>") +
        options_for_select(@headers.map{|header| force_utf8(header)}) %>
      <%= importer_hint(l(:label_unique_field_info)) %>
    </div>


    <% if @scope_attrs.present? %>
      <div id="unique_scope_fields_wrapper" class="rule-row">
        <label class="rule-label" for="unique_scope_fields"><%= l(:label_unique_scope_fields) %></label>
        <span class="unique-scope-picker">
          <%= select_tag "unique_scope_fields",
            raw("<option value=\"\">#{l(:option_ignore)}</option>") +
              options_for_select(@scope_attrs, :disabled => @disabled_scope_attrs),
            :id => 'unique_scope_fields',
            :name => 'unique_scope_fields[]' %>
          <span class="toggle-multiselect icon-only"><%= sprite_icon('') if respond_to?(:sprite_icon) %></span>
        </span>
        <%= importer_hint(l(:label_unique_scope_fields_info)) %>
      </div>
    <% end %>

    <div id="unique_scope_tracker_wrapper">
      <label>
        <%= check_box_tag "unique_scope_tracker", true, true %>
        <%= l(:label_unique_scope_tracker) %>
      </label>
      <%= importer_hint(l(:label_unique_scope_tracker_info)) %>
    </div>
    
    <div id="extract_unique_value_wrapper">
      <label>
        <%= check_box_tag "extract_unique_value", true, false %>
        <%= l(:label_extract_unique_value) %>
      </label>
      <%= importer_hint(l(:label_extract_unique_value_info)) %>
      <br/>

      <span class="extraction-options">
        &nbsp;&nbsp;&nbsp;&nbsp;
        <label>
          <%= l(:label_unique_value_separator) %>
          <%= text_field_tag "unique_value_separator",
            ImporterController::UNIQUE_VALUE_DEFAULT_SEPARATOR,
            :size => 3, :disabled => true %>
        </label>
        &nbsp;&nbsp;
        <label>
          <%= l(:label_unique_value_part) %>
          <%= select_tag "unique_value_part",
            options_for_select([[l(:label_unique_value_part_last), 'last'],
                                [l(:label_unique_value_part_first), 'first']]),
            {:disabled => true} %>
        </label>
        <br/>

        &nbsp;&nbsp;&nbsp;&nbsp;
        <label>
          <%= check_box_tag "unique_value_keep_whole", true, false, {:disabled => true} %>
          <%= l(:label_unique_value_keep_whole) %>
        </label>
        <br/>
      </span>
    </div>

    <%# Options that only apply to writing the issues: unused by the deletion %>
    <div id="write_options">
      <label>
        <%= check_box_tag "send_emails", true, false %>
        <%= l(:label_importer_send_emails) %>
      </label>
      <br/>
      <label>
        <%= check_box_tag "add_categories", true, false %>
        <%= l(:label_importer_add_categories) %>
      </label>
      <br/>
      <label>
        <%= check_box_tag "add_versions", true, false %>
        <%= l(:label_importer_add_versions) %>
      </label>
      <br/>
    </div>

    <label>
      <%= check_box_tag "use_anonymous", true, false %>
      <%= l(:label_importer_use_anonymous) %>
    </label>
    <br/>

    <%# The update is the default: a row whose issue is already there updates
        it, a row whose issue is not there creates it. Without a column
        carrying the unique values there is nothing to match by, and the
        option is switched off - the server does the same. %>
    <div id="update_issue_wrapper">
      <label>
        <%= check_box_tag "update_issue", true, true %>
        <%= l(:label_update_issue) %>
      </label>
      <%= importer_hint(l(:label_update_issue_info)) %>
    </div>

    <div id="journal_field_wrapper">
      &nbsp;&nbsp;&nbsp;&nbsp;
      <label>
        <%= l(:label_journal_field) %>
        <%= select_tag "journal_field",
          raw("<option value=\"\">#{l(:option_ignore)}</option>") +
          options_for_select(@headers.map{|header| force_utf8(header)}),
          {:disabled => true} %>
      </label>
      <br/>
    </div>

    <%# Both the update and the deletion look the issues up, so both may reach
        an issue of another project and both may meet a row nothing matches %>
    <div id="match_options">
      &nbsp;&nbsp;&nbsp;&nbsp;
      <label>
        <%= check_box_tag "update_other_project", true, false, {:disabled => true} %>
        <%= l(:label_update_other_project) %>
      </label>
      <%= importer_hint(l(:label_update_other_project_info)) %>
      <br/>

      &nbsp;&nbsp;&nbsp;&nbsp;
      <label>
        <%= check_box_tag "ignore_non_exist", true, false, {:disabled => true} %>
        <%= l(:label_ignore_non_exist) %>
      </label>
      <%= importer_hint(l(:label_ignore_non_exist_info)) %>
      <br/>
    </div>
  </fieldset>

  <%= submit_tag l(:button_redmine_importer_submit), :id => 'import-button' %>
  <br/>
<% end %>

<script type="text/javascript">
  $(document).ready(function() {
    function fieldsMapSelects() {
      return $('select[name^="fields_map"]');
    }

    // The field the column with the unique values is mapped to.
    function uniqueColumnMapping() {
      var column = $('#unique_field').val();
      if (!column) { return ''; }

      var mapping = fieldsMapSelects().filter(function() {
        return this.name === 'fields_map[' + column + ']';
      });
      return mapping.val() || '';
    }

    // Is any column of the file mapped to the id of an issue?
    function idColumnMapped() {
      return fieldsMapSelects().filter(function() {
        return $(this).val() === 'standard_field-id';
      }).length > 0;
    }

    function importByIssueId() {
      return $('#use_issue_id').is(':checked');
    }

    function deleteMode() {
      return $('#delete_issues').is(':checked');
    }

    // Matching an existing issue needs something to match it by: either the
    // import goes by the ids of the issues, or a column carrying the unique
    // values is chosen.
    function uniqueMatchingAvailable() {
      return importByIssueId() || !!$('#unique_field').val();
    }

    // Switches off the controls the current mode does not use. They stay
    // visible, so that the configuration underneath keeps reading the way it
    // was left; disabled controls are not submitted, and the server ignores
    // their values anyway.
    function toggleModes() {
      var deleting = deleteMode();
      var matching = uniqueMatchingAvailable();

      // nothing is written to the issues while they are being deleted
      $('#write_options').toggleClass('importer-disabled', deleting);
      $('#send_emails, #add_categories, #add_versions').prop('disabled', deleting);

      // no unique values, nothing to look the issues up by: everything the
      // file holds can only be imported as new issues
      var canUpdate = matching && !deleting;
      $('#update_issue').prop('disabled', !canUpdate);
      $('#update_issue_wrapper').toggleClass('importer-disabled', !canUpdate);

      var updating = canUpdate && $('#update_issue').is(':checked');
      $('#journal_field').prop('disabled', !updating);
      $('#journal_field_wrapper').toggleClass('importer-disabled', !updating);

      // the update and the deletion both look the issues up
      var lookingUp = updating || (deleting && matching);
      $('#update_other_project, #ignore_non_exist').prop('disabled', !lookingUp);
      $('#match_options').toggleClass('importer-disabled', !lookingUp);

      // the deletion has nothing to work on without the unique values, and
      // the server refuses such a file
      $('#delete_issues_warning').toggle(deleting && !matching);
    }

    // The import by ids needs a column mapped to the id: the ids are read
    // from it. Warn as soon as the option is turned on without such a column,
    // the same condition is enforced on the server.
    function toggleIdColumnWarning() {
      $('#use_issue_id_warning').toggle(importByIssueId() && !idColumnMapped());
    }

    // Collapsed: a plain drop-down for a single field.
    // Expanded (the "+" icon): a list allowing several fields at once.
    // Both the icon and the switching are handled by the core application.js
    // (toggleMultiSelect / toggleMultiSelectIconInit), exactly as in the filters.
    var scopeSelect = $('#unique_scope_fields');

    // The whole "unique values" configuration makes no sense when the issues
    // are matched by their id: an id is unique by itself, there is nothing to
    // narrow down and nothing to extract. That is the case when the import
    // goes by the ids of the issues, and when the unique column itself is
    // mapped to the id.
    //
    // The import by ids switches the controls off but keeps them visible, so
    // that the configuration underneath stays readable. Disabled controls are
    // not submitted, and the server ignores their values anyway.
    function toggleUniqueMatching() {
      var byIssueId = importByIssueId();
      var uniqueColumnIsId = uniqueColumnMapping() === 'standard_field-id';
      var inactive = byIssueId || uniqueColumnIsId;

      // the column with the unique values is replaced by the id column
      $('#unique_field').prop('disabled', byIssueId);
      $('#unique_field_wrapper').toggleClass('importer-disabled', byIssueId);

      var trackerWrapper = $('#unique_scope_tracker_wrapper');
      trackerWrapper.toggle(!uniqueColumnIsId);
      trackerWrapper.toggleClass('importer-disabled', inactive);
      $('#unique_scope_tracker').prop('disabled', inactive);

      var scopeWrapper = $('#unique_scope_fields_wrapper');
      if (scopeWrapper.length) {
        scopeWrapper.toggle(!uniqueColumnIsId);
        scopeWrapper.toggleClass('importer-disabled', inactive);
        scopeSelect.prop('disabled', inactive);
      }

      var extractWrapper = $('#extract_unique_value_wrapper');
      if (extractWrapper.length) {
        extractWrapper.toggle(!uniqueColumnIsId);
        extractWrapper.toggleClass('importer-disabled', inactive);
        $('#extract_unique_value').prop('disabled', inactive);
        // the option is meaningless for a column holding the ids, while the
        // import by ids is a temporary switch and keeps the choice untouched
        if (uniqueColumnIsId) { $('#extract_unique_value').prop('checked', false); }

        var enabled = !inactive && $('#extract_unique_value').is(':checked');
        $('#unique_value_separator, #unique_value_part, #unique_value_keep_whole')
          .prop('disabled', !enabled);
        extractWrapper.find('.extraction-options').toggle(enabled);
      }
    }

    function refreshImportRules() {
      toggleIdColumnWarning();
      toggleUniqueMatching();
      toggleModes();
    }

    $('#use_issue_id, #unique_field, #extract_unique_value, #update_issue, #delete_issues')
      .add(fieldsMapSelects())
      .on('change', refreshImportRules);
    refreshImportRules();

    // ------------------------------------------------------------------
    // Progress of the import
    // ------------------------------------------------------------------
    var progressPanel = $('#import-progress-panel');
    var progressBar = $('#import-progress');
    var hasProgressbar = typeof $.fn.progressbar === 'function';

    function stageLabel(stage) {
      var labels = progressPanel.data('stage-labels') || {};
      return labels[stage] || labels['importing'] || '';
    }

    // The rows of the file have not been counted yet, or the state cannot be
    // read at all: the widget then runs its indeterminate animation instead of
    // claiming a position it does not know.
    function setBar(value, max) {
      if (!hasProgressbar) { return; }
      if (value === false) {
        progressBar.progressbar('option', 'value', false);
      } else {
        progressBar.progressbar('option', {max: Math.max(1, max), value: value});
      }
    }

    function renderProgress(status) {
      var total = status.total_rows > 0 ? status.total_rows : 0;

      $('#import-progress-stage').text(stageLabel(status.stage));
      $('#progress-label').text(status.processed_rows + ' / ' + total);
      $('#import-progress-created').text(status.created_count);
      $('#import-progress-updated').text(status.updated_count);
      $('#import-progress-unchanged').text(status.unchanged_count);
      $('#import-progress-deleted').text(status.deleted_count);
      $('#import-progress-skipped').text(status.skipped_count);
      $('#import-progress-failed').text(status.failed_count);

      if (!status.finished && total === 0) {
        setBar(false);
      } else {
        setBar(status.processed_rows, total);
      }
    }

    // The state cannot always be read while the import is running: a server
    // serving a single request at a time answers the polls only after the
    // import is over. The bar then says that the import goes on without
    // saying how far it is, instead of standing still at zero.
    function progressUnavailable() {
      setBar(false);
      $('#import-progress-stalled').show();
    }

    // The state is being read again: the note about the unreadable progress
    // goes away, the bar is set by renderProgress below.
    function progressAvailable() {
      $('#import-progress-stalled').hide();
    }

    // The form is submitted the ordinary way. The browser keeps this page
    // alive until the answer arrives, so the panel goes on polling while the
    // import runs, and the result page then loads as a normal page. The
    // polling stops by itself when the browser leaves for it.
    function watchProgress() {
      // the deletion fills a counter of its own and none of the others
      var deleting = deleteMode();
      $('.importer-progress-write').toggle(!deleting);
      $('.importer-progress-delete').toggle(deleting);

      $('#map_form, #csv-preview').hide();
      progressPanel.show();
      if (hasProgressbar) { progressBar.progressbar({value: false}); }

      var misses = 0;
      setInterval(function() {
        $.ajax({url: progressPanel.data('progress-url'),
                dataType: 'json',
                cache: false,
                // no global ajax events: they would flash the "loading" box of
                // Redmine over the page on every poll
                global: false})
          .done(function(status) {
            if (status && status.stage && status.stage !== 'unknown') {
              misses = 0;
              progressAvailable();
              renderProgress(status);
            } else if (++misses >= 5) {
              progressUnavailable();
            }
          })
          .fail(function() {
            if (++misses >= 5) { progressUnavailable(); }
          });
      }, 1000);
    }

    $('#map_form').on('submit', function() {
      $('#import-button').prop('disabled', true).css({opacity: '0.65', cursor: 'not-allowed'});
      if (progressPanel.length) { watchProgress(); }
      return true;
    });
  });
</script>

<div id="csv-preview">
<hr/>

<%= l(:label_toplines, @original_filename) %>
<table class="list">
  <thead>
    <tr>
      <% @headers.each do |column| %>
        <th><%= force_utf8(column) %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @samples.each do |issue| -%>
      <tr class="<%= cycle("odd", "even") %>">
        <% issue.each do |column| %>
          <% column[1] = force_utf8(column[1]) if column[1].kind_of?(String) %>
          <%= content_tag 'td', column[1] %>
        <% end %>
      </tr>
    <% end %>
    <tr class="<%= cycle("odd", "even") %>">
      <% @headers.each do |column| %><td>...</td><% end %>
    </tr>
  </tbody>
</table>
</div>
