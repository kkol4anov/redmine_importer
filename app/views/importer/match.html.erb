<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'importer', :plugin => 'redmine_importer' %>
<% end %>

<% content_for :update_issue_javascript do %>
  <script type='text/javascript'>
    $(function() {
      $('#update_issue').change(function() {
        $('#journal_field').attr('disabled', !this.checked)
        $('#update_other_project').attr('disabled', !this.checked)
        $('#ignore_non_exist').attr('disabled', !this.checked)
      }).change();
    })
  </script>
<% end %>

<h2><%= l(:label_match_columns) %></h2>

<%= form_tag({:action => 'result'}, {:multipart => true, :id => 'map_form'}) do %>
  <%= hidden_field_tag 'project_id', @project.id %>
  <%= hidden_field_tag 'import_timestamp', @import_timestamp %>

  <fieldset class="box">
    <legend><%= l(:label_match_select) %></legend>
    <% @headers.each do |column| %>
      <% col = force_utf8(column) %>
      <label class="tabular">
        <%= col %>:
        <%= select_tag "fields_map[#{col}]",
          raw("<option value=\"\">#{l(:option_ignore)}</option>") +
            options_for_select( @attrs, matched_attrs(column) ) %>
      </label>
    <% end %>
  </fieldset>

  <fieldset class="box">
    <legend><%= l(:label_import_rule) %></legend>
    
    <label>
      <%= check_box_tag "use_issue_id", true, false %>
      <%= l(:label_importer_use_issue_id) %>
    </label>
    <%= importer_hint(l(:label_importer_use_issue_id_info)) %>
    <span id="use_issue_id_warning" class="importer-warning" style="display: none;">
      <%= l(:warning_id_column_not_mapped) %>
    </span>
    <br/>

    <div class="rule-row">
      <label class="rule-label" for="default_tracker"><%= l(:label_default_tracker) %></label>
      <%= select_tag "default_tracker",
        options_from_collection_for_select(@project.trackers, 'id', 'name') %>
    </div>

    <div id="unique_field_wrapper" class="rule-row">
      <label class="rule-label" for="unique_field"><%= l(:label_unique_field) %></label>
      <%= select_tag "unique_field",
        raw("<option value=\"\">#{l(:option_ignore)}</option>") +
        options_for_select(@headers.map{|header| force_utf8(header)}) %>
      <%= importer_hint(l(:label_unique_field_info)) %>
    </div>


    <% if @scope_attrs.present? %>
      <div id="unique_scope_fields_wrapper" class="rule-row">
        <label class="rule-label" for="unique_scope_fields"><%= l(:label_unique_scope_fields) %></label>
        <span class="unique-scope-picker">
          <%= select_tag "unique_scope_fields",
            raw("<option value=\"\">#{l(:option_ignore)}</option>") +
              options_for_select(@scope_attrs, :disabled => @disabled_scope_attrs),
            :id => 'unique_scope_fields',
            :name => 'unique_scope_fields[]' %>
          <span class="toggle-multiselect icon-only"><%= sprite_icon('') if respond_to?(:sprite_icon) %></span>
        </span>
        <%= importer_hint(l(:label_unique_scope_fields_info)) %>
      </div>
    <% end %>

    <div id="unique_scope_tracker_wrapper">
      <label>
        <%= check_box_tag "unique_scope_tracker", true, true %>
        <%= l(:label_unique_scope_tracker) %>
      </label>
      <%= importer_hint(l(:label_unique_scope_tracker_info)) %>
    </div>
    
    <div id="extract_unique_value_wrapper">
      <label>
        <%= check_box_tag "extract_unique_value", true, false %>
        <%= l(:label_extract_unique_value) %>
      </label>
      <%= importer_hint(l(:label_extract_unique_value_info)) %>
      <br/>

      <span class="extraction-options">
        &nbsp;&nbsp;&nbsp;&nbsp;
        <label>
          <%= l(:label_unique_value_separator) %>
          <%= text_field_tag "unique_value_separator",
            ImporterController::UNIQUE_VALUE_DEFAULT_SEPARATOR,
            :size => 3, :disabled => true %>
        </label>
        &nbsp;&nbsp;
        <label>
          <%= l(:label_unique_value_part) %>
          <%= select_tag "unique_value_part",
            options_for_select([[l(:label_unique_value_part_last), 'last'],
                                [l(:label_unique_value_part_first), 'first']]),
            {:disabled => true} %>
        </label>
        <br/>

        &nbsp;&nbsp;&nbsp;&nbsp;
        <label>
          <%= check_box_tag "unique_value_keep_whole", true, false, {:disabled => true} %>
          <%= l(:label_unique_value_keep_whole) %>
        </label>
        <br/>
      </span>
    </div>

    <label>
      <%= check_box_tag "send_emails", true, false %>
      <%= l(:label_importer_send_emails) %>
    </label>
    <br/>
    <label>
      <%= check_box_tag "add_categories", true, false %>
      <%= l(:label_importer_add_categories) %>
    </label>
    <br/>
    <label>
      <%= check_box_tag "add_versions", true, false %>
      <%= l(:label_importer_add_versions) %>
    </label>
    <br/>
    <label>
      <%= check_box_tag "use_anonymous", true, false %>
      <%= l(:label_importer_use_anonymous) %>
    </label>
    <br/>
    <label>
      <%= check_box_tag "update_issue", true, false %>
      <%= l(:label_update_issue) %>
    </label>
    <br/>

    <%= yield :update_issue_javascript %>

    &nbsp;&nbsp;&nbsp;&nbsp;
    <label>
      <%= l(:label_journal_field) %>
      <%= select_tag "journal_field",
        raw("<option value=\"\">#{l(:option_ignore)}</option>") +
        options_for_select(@headers.map{|header| force_utf8(header)}),
        {:disabled => true} %>
    </label>
    <br/>

    &nbsp;&nbsp;&nbsp;&nbsp;
    <label>
      <%= check_box_tag "update_other_project", true, false, {:disabled => true} %>
      <%= l(:label_update_other_project) %>
    </label>
    <br/>

    &nbsp;&nbsp;&nbsp;&nbsp;
    <label>
      <%= check_box_tag "ignore_non_exist", true, false, {:disabled => true} %>
      <%= l(:label_ignore_non_exist) %>
    </label>
    <br/>
  </fieldset>

  <%= submit_tag l(:button_redmine_importer_submit), :id => 'import-button' %>
  <br/>
<% end %>

<script type="text/javascript">
  $(document).ready(function() {
    function fieldsMapSelects() {
      return $('select[name^="fields_map"]');
    }

    // The field the column with the unique values is mapped to.
    function uniqueColumnMapping() {
      var column = $('#unique_field').val();
      if (!column) { return ''; }

      var mapping = fieldsMapSelects().filter(function() {
        return this.name === 'fields_map[' + column + ']';
      });
      return mapping.val() || '';
    }

    // Is any column of the file mapped to the id of an issue?
    function idColumnMapped() {
      return fieldsMapSelects().filter(function() {
        return $(this).val() === 'standard_field-id';
      }).length > 0;
    }

    function importByIssueId() {
      return $('#use_issue_id').is(':checked');
    }

    // The import by ids needs a column mapped to the id: the ids are read
    // from it. Warn as soon as the option is turned on without such a column,
    // the same condition is enforced on the server.
    function toggleIdColumnWarning() {
      $('#use_issue_id_warning').toggle(importByIssueId() && !idColumnMapped());
    }

    // Collapsed: a plain drop-down for a single field.
    // Expanded (the "+" icon): a list allowing several fields at once.
    // Both the icon and the switching are handled by the core application.js
    // (toggleMultiSelect / toggleMultiSelectIconInit), exactly as in the filters.
    var scopeSelect = $('#unique_scope_fields');

    // The whole "unique values" configuration makes no sense when the issues
    // are matched by their id: an id is unique by itself, there is nothing to
    // narrow down and nothing to extract. That is the case when the import
    // goes by the ids of the issues, and when the unique column itself is
    // mapped to the id.
    //
    // The import by ids switches the controls off but keeps them visible, so
    // that the configuration underneath stays readable. Disabled controls are
    // not submitted, and the server ignores their values anyway.
    function toggleUniqueMatching() {
      var byIssueId = importByIssueId();
      var uniqueColumnIsId = uniqueColumnMapping() === 'standard_field-id';
      var inactive = byIssueId || uniqueColumnIsId;

      // the column with the unique values is replaced by the id column
      $('#unique_field').prop('disabled', byIssueId);
      $('#unique_field_wrapper').toggleClass('importer-disabled', byIssueId);

      var trackerWrapper = $('#unique_scope_tracker_wrapper');
      trackerWrapper.toggle(!uniqueColumnIsId);
      trackerWrapper.toggleClass('importer-disabled', inactive);
      $('#unique_scope_tracker').prop('disabled', inactive);

      var scopeWrapper = $('#unique_scope_fields_wrapper');
      if (scopeWrapper.length) {
        scopeWrapper.toggle(!uniqueColumnIsId);
        scopeWrapper.toggleClass('importer-disabled', inactive);
        scopeSelect.prop('disabled', inactive);
      }

      var extractWrapper = $('#extract_unique_value_wrapper');
      if (extractWrapper.length) {
        extractWrapper.toggle(!uniqueColumnIsId);
        extractWrapper.toggleClass('importer-disabled', inactive);
        $('#extract_unique_value').prop('disabled', inactive);
        // the option is meaningless for a column holding the ids, while the
        // import by ids is a temporary switch and keeps the choice untouched
        if (uniqueColumnIsId) { $('#extract_unique_value').prop('checked', false); }

        var enabled = !inactive && $('#extract_unique_value').is(':checked');
        $('#unique_value_separator, #unique_value_part, #unique_value_keep_whole')
          .prop('disabled', !enabled);
        extractWrapper.find('.extraction-options').toggle(enabled);
      }
    }

    function refreshImportRules() {
      toggleIdColumnWarning();
      toggleUniqueMatching();
    }

    $('#use_issue_id, #unique_field, #extract_unique_value')
      .add(fieldsMapSelects())
      .on('change', refreshImportRules);
    refreshImportRules();

    $('#map_form').on('submit', function() {
      $('#import-button').prop('disabled', true).css({opacity: '0.65', cursor: 'not-allowed'});
    });
  });
</script>

<hr/>

<%= l(:label_toplines, @original_filename) %>
<table class="list">
  <thead>
    <tr>
      <% @headers.each do |column| %>
        <th><%= force_utf8(column) %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @samples.each do |issue| -%>
      <tr class="<%= cycle("odd", "even") %>">
        <% issue.each do |column| %>
          <% column[1] = force_utf8(column[1]) if column[1].kind_of?(String) %>
          <%= content_tag 'td', column[1] %>
        <% end %>
      </tr>
    <% end %>
    <tr class="<%= cycle("odd", "even") %>">
      <% @headers.each do |column| %><td>...</td><% end %>
    </tr>
  </tbody>
</table>
